{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["demo/src/*"],
      "@components/*": ["components/*"]
    },
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["@dcloudio/types"]
  },
  "include": [
    "demo/src/**/*",
    "components/**/*",
    "libs/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/unpackage",
    "**/dist"
  ]
}
